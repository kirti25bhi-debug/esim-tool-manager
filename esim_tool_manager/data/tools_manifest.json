{
  "schema_version": "1.0",
  "tools": [
    {
      "id": "ngspice",
      "name": "Ngspice Circuit Simulator",
      "category": "Simulation",
      "description": "General purpose mixed-level / mixed-signal circuit simulator engine for eSim.",
      "binary_name": {
        "linux": "ngspice",
        "darwin": "ngspice",
        "windows": "ngspice.exe",
        "default": "ngspice"
      },
      "version_command": {
        "default": ["ngspice", "-v"]
      },
      "version_regex": "(?:ngspice-|Ngspice\\s+version\\s+|ngspice\\s+)(\\d+(?:\\.\\d+)*)",
      "min_version": "38",
      "max_version": null,
      "recommended_version": "43",
      "dependencies": ["libngspice", "gcc"],
      "env_vars": {
        "NGSPICE_PATH": "{executable_path}",
        "SPICE_LIB_DIR": "{executable_dir}/../share/ngspice"
      },
      "platform_packages": {
        "linux": {
          "package_name": "ngspice",
          "package_manager": "apt",
          "install_args": ["-y", "install", "ngspice", "libngspice0"],
          "download_url": "https://sourceforge.net/projects/ngspice/files/ng-spice-rework/43/ngspice-43.tar.gz"
        },
        "darwin": {
          "package_name": "ngspice",
          "package_manager": "brew",
          "install_args": ["install", "ngspice"],
          "download_url": "https://sourceforge.net/projects/ngspice/files/ng-spice-rework/43/ngspice-43.tar.gz"
        },
        "windows": {
          "package_name": "Ngspice.Ngspice",
          "package_manager": "winget",
          "install_args": ["install", "--id", "Ngspice.Ngspice", "-e"],
          "download_url": "https://sourceforge.net/projects/ngspice/files/ng-spice-rework/43/ngspice-43_64.zip",
          "archive_type": "zip",
          "binary_relative_path": "Spice64/bin/ngspice.exe"
        }
      },
      "verification_command": ["ngspice", "--version"],
      "is_required": true,
      "doc_url": "https://ngspice.sourceforge.io/"
    },
    {
      "id": "kicad",
      "name": "KiCad EDA Suite",
      "category": "Schematic & PCB",
      "description": "Schematic editor (Eeschema) and PCB layout engine integrated into eSim workflow.",
      "binary_name": {
        "linux": "kicad-cli",
        "darwin": "kicad-cli",
        "windows": "kicad-cli.exe",
        "default": "kicad-cli"
      },
      "version_command": {
        "default": ["kicad-cli", "version"],
        "darwin": ["/Applications/KiCad/KiCad.app/Contents/MacOS/kicad-cli", "version"]
      },
      "version_regex": "(\\d+\\.\\d+(?:\\.\\d+)?)",
      "min_version": "6.0.0",
      "max_version": "9.0.0",
      "recommended_version": "7.0.11",
      "dependencies": [],
      "env_vars": {
        "KICAD_PATH": "{executable_path}",
        "KICAD_CLI_PATH": "{executable_path}"
      },
      "platform_packages": {
        "linux": {
          "package_name": "kicad",
          "package_manager": "apt",
          "install_args": ["-y", "install", "kicad"],
          "download_url": "https://www.kicad.org/download/linux/"
        },
        "darwin": {
          "package_name": "kicad",
          "package_manager": "brew",
          "install_args": ["install", "--cask", "kicad"],
          "download_url": "https://www.kicad.org/download/macos/"
        },
        "windows": {
          "package_name": "KiCad.KiCad",
          "package_manager": "winget",
          "install_args": ["install", "--id", "KiCad.KiCad", "-e"],
          "download_url": "https://www.kicad.org/download/windows/"
        }
      },
      "verification_command": ["kicad-cli", "--help"],
      "is_required": true,
      "doc_url": "https://www.kicad.org/"
    },
    {
      "id": "ghdl",
      "name": "GHDL VHDL Simulator",
      "category": "Digital Design",
      "description": "VHDL analyzer, compiler, and simulator for digital blocks and mixed-signal co-simulation.",
      "binary_name": {
        "linux": "ghdl",
        "darwin": "ghdl",
        "windows": "ghdl.exe",
        "default": "ghdl"
      },
      "version_command": {
        "default": ["ghdl", "--version"]
      },
      "version_regex": "GHDL\\s+(\\d+(?:\\.\\d+)*(?:-[a-zA-Z0-9]+)?)",
      "min_version": "1.0.0",
      "max_version": null,
      "recommended_version": "3.0.0",
      "dependencies": ["gcc"],
      "env_vars": {
        "GHDL_PATH": "{executable_path}"
      },
      "platform_packages": {
        "linux": {
          "package_name": "ghdl",
          "package_manager": "apt",
          "install_args": ["-y", "install", "ghdl"],
          "download_url": "https://github.com/ghdl/ghdl/releases"
        },
        "darwin": {
          "package_name": "ghdl",
          "package_manager": "brew",
          "install_args": ["install", "ghdl"],
          "download_url": "https://github.com/ghdl/ghdl/releases"
        },
        "windows": {
          "package_name": "GHDL.GHDL",
          "package_manager": "winget",
          "install_args": ["install", "--id", "GHDL.GHDL", "-e"],
          "download_url": "https://github.com/ghdl/ghdl/releases"
        }
      },
      "verification_command": ["ghdl", "--version"],
      "is_required": false,
      "doc_url": "https://ghdl.github.io/ghdl/"
    },
