  "python_dependencies": [
    {
      "id": "numpy",
      "name": "NumPy",
      "category": "Python Library",
      "min_version": "1.20.0",
      "description": "Core numerical computing array library used in simulation data processing."
    },
    {
      "id": "scipy",
      "name": "SciPy",
      "category": "Python Library",
      "min_version": "1.7.0",
      "description": "Scientific algorithms and signal processing for eSim transient analysis."
    },
    {
      "id": "matplotlib",
      "name": "Matplotlib",
      "category": "Python Library",
